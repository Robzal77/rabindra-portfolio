---
const email = 'mailto:Rabindra.rizal@gmail.com';
const linkedin = 'https://www.linkedin.com/in/rabindrarizal';
const github = 'https://github.com/Robzal77';
const githubAvatar = 'https://avatars.githubusercontent.com/u/39091246?v=4&s=320';

const projects = [
	{
		id: 'carbon',
		number: '01',
		label: 'Sustainability data product',
		title: 'Global carbon reporting, rebuilt for control and scale.',
		description: 'Led the roadmap, operating controls and cross-functional delivery that moved a four-zone reporting process away from manual collection toward a governed data product.',
		outcomes: ['90% less manual effort', '97% reported accuracy', 'Audit-ready controls'],
		tools: 'Microsoft Fabric · Databricks · ADF · Power BI',
	},
	{
		id: 'framework',
		number: '02',
		label: 'Analytics operating model',
		title: 'A reusable system for better Power BI products.',
		description: 'Created an excellence framework joining code-native development, semantic-model standards, report-health scoring, design assets and documentation into one practical way of working.',
		outcomes: ['~7 FTE annual value', '40% less fragmentation', '67% less recurring work'],
		tools: 'PBIP · TMDL · Git · Python · Governance',
	},
	{
		id: 'sales',
		number: '03',
		label: 'Commercial analytics',
		title: 'Europe Daily Sales, modernised around trust.',
		description: 'Led the Qlik-to-Power BI modernisation, then used adoption, feedback and quality signals to keep improving the product after launch.',
		outcomes: ['13h → 2h refresh', '260+ daily views', 'NPS 46 → 81'],
		tools: 'Discovery · Semantic models · Power BI · Adoption',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0d1714" />
		<meta name="description" content="Rabindra Rizal is a technology and program leader building trusted data, analytics, automation and responsible AI systems." />
		<meta property="og:title" content="Rabindra Rizal — Data, analytics & AI systems" />
		<meta property="og:description" content="Selected work in global analytics, automation, responsible AI and enterprise data products." />
		<meta property="og:type" content="website" />
		<meta name="twitter:card" content="summary" />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<title>Rabindra Rizal — Data, analytics & AI systems</title>
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'Person',
			name: 'Rabindra Rizal',
			jobTitle: 'Technology & Program Manager',
			url: Astro.url.href,
			sameAs: [linkedin, github],
			knowsAbout: ['Data products', 'Business intelligence', 'Analytics platforms', 'Responsible AI', 'Program management'],
		})}></script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>

		<header class="site-header">
			<div class="shell header-inner">
				<a class="brand" href="#top" aria-label="Rabindra Rizal, home">
					<span class="brand-mark">RR</span>
					<span class="brand-copy"><strong>Rabindra Rizal</strong><small>Data · Analytics · AI</small></span>
				</a>
				<nav aria-label="Primary navigation">
					<a href="#work">Work</a>
					<a href="#approach">Approach</a>
					<a href="#experience">Experience</a>
				</nav>
				<a class="nav-cta" href={email}>Let’s talk <span aria-hidden="true">↗</span></a>
			</div>
		</header>

		<main id="main">
			<section class="hero shell" id="top" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="availability"><span></span> Bengaluru based · working globally</p>
					<h1 id="hero-title">I build the systems behind <em>trusted decisions.</em></h1>
					<p class="hero-lede">Technology and program leader working across enterprise analytics, automation and responsible AI—from the problem framing through to adoption.</p>
					<div class="hero-actions">
						<a class="button button-primary" href="#work">Explore selected work <span aria-hidden="true">↓</span></a>
						<a class="button button-secondary" href={email}>Start a conversation</a>
					</div>
				</div>

				<aside class="profile-panel" aria-label="Rabindra Rizal profile">
					<div class="profile-top">
						<img src={githubAvatar} alt="Rabindra Rizal" width="88" height="88" loading="eager" />
						<div><p>Rabindra Rizal</p><span>Technology & Program Manager</span></div>
					</div>
					<p class="profile-note">Making complex data work clearer, repeatable and useful at global scale.</p>
					<div class="profile-stats">
						<div><strong>12+</strong><span>years across engineering, BI and program leadership</span></div>
						<div><strong>3</strong><span>global portfolios across sustainability, logistics and commercial</span></div>
					</div>
					<div class="profile-links">
						<a href={github} target="_blank" rel="noreferrer">GitHub <span>@Robzal77 ↗</span></a>
						<a href={linkedin} target="_blank" rel="noreferrer">LinkedIn <span>Connect ↗</span></a>
					</div>
				</aside>
			</section>

			<section class="signal-strip" aria-label="Core practice areas">
				<div class="shell signal-inner">
					<p>What I bring</p>
					<ul>
						<li>Product thinking</li><li>Data platforms</li><li>Operating models</li><li>Responsible AI</li><li>Team enablement</li>
					</ul>
				</div>
			</section>

			<section class="work-section shell" id="work" aria-labelledby="work-title">
				<div class="section-heading">
					<div><p class="eyebrow">Selected case studies</p><h2 id="work-title">Work with measurable<br />life after launch.</h2></div>
					<p>Not a gallery of deliverables. These are systems shaped around decisions, controls, adoption and the people who operate them.</p>
				</div>

				<div class="project-grid">
					{projects.map((project, index) => (
						<article class:list={["project-card", `project-${project.id}`, { featured: index === 0 }]}>
							<div class="project-visual" aria-hidden="true">
								{project.id === 'carbon' && (
									<div class="carbon-ui">
										<div class="ui-bar"><i></i><i></i><i></i><span>Carbon control centre</span></div>
										<div class="carbon-main"><div class="score"><strong>97%</strong><span>quality score</span></div><div class="zone-list"><span><i></i>Europe <b>Ready</b></span><span><i></i>APAC <b>Ready</b></span><span><i></i>Americas <b>Ready</b></span><span><i></i>Africa <b>Review</b></span></div></div>
										<div class="carbon-bars"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
									</div>
								)}
								{project.id === 'framework' && (
									<div class="framework-ui">
										<p>BI product system</p>
										<div class="system-row"><span>01</span><strong>Model</strong><i>Semantic standards</i></div>
										<div class="system-row active"><span>02</span><strong>Build</strong><i>PBIP + Git</i></div>
										<div class="system-row"><span>03</span><strong>Review</strong><i>Health scoring</i></div>
										<div class="system-row"><span>04</span><strong>Scale</strong><i>Reusable assets</i></div>
									</div>
								)}
								{project.id === 'sales' && (
									<div class="sales-ui">
										<div class="sales-head"><span>Europe daily sales</span><strong>02:06</strong></div>
										<svg viewBox="0 0 520 190" role="presentation"><defs><linearGradient id="area" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#31d49b" stop-opacity=".35"/><stop offset="1" stop-color="#31d49b" stop-opacity="0"/></linearGradient></defs><path d="M0 155 C55 155 65 128 110 132 S180 88 225 104 S290 58 345 71 S415 35 520 24 L520 190 L0 190 Z" fill="url(#area)"/><path d="M0 155 C55 155 65 128 110 132 S180 88 225 104 S290 58 345 71 S415 35 520 24" fill="none" stroke="#31d49b" stroke-width="4"/><circle cx="520" cy="24" r="7" fill="#31d49b"/></svg>
										<div class="chart-foot"><span>Refresh duration</span><strong>13h → 2h</strong></div>
									</div>
								)}
							</div>
							<div class="project-copy">
								<div class="project-meta"><span>{project.number}</span><p>{project.label}</p></div>
								<h3>{project.title}</h3>
								<p class="project-description">{project.description}</p>
								<ul class="outcome-list" aria-label="Project outcomes">{project.outcomes.map((outcome) => <li>{outcome}</li>)}</ul>
								<p class="tool-line">{project.tools}</p>
							</div>
						</article>
					))}
				</div>
			</section>

			<section class="approach-section" id="approach" aria-labelledby="approach-title">
				<div class="shell">
					<div class="section-heading light-heading">
						<div><p class="eyebrow">How I work</p><h2 id="approach-title">Clarity before velocity.<br />Adoption before applause.</h2></div>
						<p>The technology matters. The operating model determines whether it keeps mattering six months later.</p>
					</div>
					<div class="approach-grid">
						<article><span>01</span><h3>Frame the decision</h3><p>Start with who needs to decide what, then shape the product, measures and roadmap around that reality.</p></article>
						<article><span>02</span><h3>Build trust into the system</h3><p>Make ownership, definitions, controls and quality visible—so confidence does not depend on tribal knowledge.</p></article>
						<article><span>03</span><h3>Design for the next team</h3><p>Use standards, documentation and enablement to leave capability behind, not another permanent dependency.</p></article>
					</div>
				</div>
			</section>

			<section class="ai-section shell" aria-labelledby="ai-title">
				<div class="ai-card">
					<div class="ai-intro"><p class="eyebrow">AI in practice</p><h2 id="ai-title">Useful AI is a workflow,<br />not a feature badge.</h2><p>I use AI to shorten the distance between intent and a trustworthy outcome—with human review, explicit controls and evidence that it helped.</p></div>
					<div class="ai-steps">
						<div><span>Ground</span><p>Use governed context, definitions and source material.</p></div>
						<div><span>Assist</span><p>Apply agents to repeatable analysis and documentation work.</p></div>
						<div><span>Review</span><p>Keep accountable people in validation and release.</p></div>
						<div><span>Measure</span><p>Track quality, effort saved and adoption—not novelty.</p></div>
					</div>
				</div>
			</section>

			<section class="experience-section shell" id="experience" aria-labelledby="experience-title">
				<div class="experience-heading"><p class="eyebrow">Experience</p><h2 id="experience-title">Engineer turned analytics<br />and program leader.</h2></div>
				<div class="timeline">
					<article><time>2022—now</time><div><h3>Technology & Program Manager</h3><p>AB InBev · Global analytics, automation and data products</p></div><span>Current</span></article>
					<article><time>2021—22</time><div><h3>Principal Analyst</h3><p>AB InBev · Product modernisation and adoption</p></div></article>
					<article><time>2014—21</time><div><h3>Implementation Engineer → BI Lead</h3><p>Wipro · Engineering, analytics and team delivery</p></div></article>
				</div>
			</section>

			<section class="contact-section">
				<div class="shell contact-inner">
					<p class="eyebrow">Let’s make the complex useful</p>
					<h2>Have a data or AI program<br />that needs a clearer path?</h2>
					<div class="contact-actions"><a class="button button-contact" href={email}>Email Rabindra <span aria-hidden="true">↗</span></a><a href={linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><a href={github} target="_blank" rel="noreferrer">GitHub ↗</a></div>
				</div>
			</section>
		</main>

		<footer class="site-footer shell">
			<p>© {new Date().getFullYear()} Rabindra Rizal</p>
			<p>Designed for clarity. Built with Astro.</p>
			<a href="#top">Back to top ↑</a>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--ink: #10201b;
		--forest: #0d1714;
		--green: #1d4b3b;
		--mint: #31d49b;
		--lime: #d7f67a;
		--paper: #f7f5ef;
		--white: #fffefa;
		--sand: #e8e4da;
		--muted: #637068;
		--line: #d8d7cf;
		--blue: #dce8ff;
		--max: 1180px;
		font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
		color: var(--ink);
		background: var(--paper);
		font-synthesis: none;
	}
	* { box-sizing: border-box; }
	html { scroll-behavior: smooth; scroll-padding-top: 96px; }
	body { margin: 0; background: var(--paper); line-height: 1.55; }
	a { color: inherit; }
	a:focus-visible { outline: 3px solid var(--mint); outline-offset: 4px; }
	::selection { color: var(--forest); background: var(--lime); }
	.shell { width: min(calc(100% - 48px), var(--max)); margin-inline: auto; }
	.skip-link { position: fixed; z-index: 50; top: 12px; left: 12px; padding: 10px 14px; color: white; background: var(--forest); transform: translateY(-160%); }
	.skip-link:focus { transform: translateY(0); }

	.site-header { position: sticky; z-index: 20; top: 0; border-bottom: 1px solid rgba(16,32,27,.1); background: rgba(247,245,239,.9); backdrop-filter: blur(18px); }
	.header-inner { min-height: 78px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; }
	.brand { width: fit-content; display: flex; align-items: center; gap: 12px; text-decoration: none; }
	.brand-mark { width: 38px; height: 38px; display: grid; place-items: center; border-radius: 11px; color: var(--white); background: var(--forest); font: 750 .82rem/1 ui-sans-serif, system-ui; letter-spacing: -.03em; }
	.brand-copy { display: grid; line-height: 1.15; }
	.brand-copy strong { font-size: .84rem; }
	.brand-copy small { margin-top: 4px; color: var(--muted); font-size: .66rem; }
	nav { display: flex; gap: 30px; }
	nav a, .nav-cta { font-size: .78rem; font-weight: 700; text-decoration: none; }
	nav a { color: #46534b; }
	nav a:hover { color: var(--ink); }
	.nav-cta { justify-self: end; padding: 10px 14px; border-radius: 99px; color: white; background: var(--forest); }

	.hero { min-height: calc(100vh - 78px); padding-block: clamp(70px, 9vw, 118px); display: grid; grid-template-columns: 1.35fr .65fr; align-items: center; gap: clamp(60px, 9vw, 130px); }
	.availability, .eyebrow { margin: 0; color: var(--muted); font-size: .68rem; font-weight: 800; text-transform: uppercase; letter-spacing: .13em; }
	.availability { display: flex; align-items: center; gap: 9px; }
	.availability span { width: 8px; height: 8px; border-radius: 50%; background: var(--mint); box-shadow: 0 0 0 4px rgba(49,212,155,.15); }
	h1, h2, h3, p { text-wrap: pretty; }
	h1, h2, h3 { margin: 0; }
	h1 { max-width: 820px; margin-top: 25px; font-size: clamp(3.6rem, 6.9vw, 7.2rem); line-height: .94; letter-spacing: -.065em; }
	h1 em { color: var(--green); font-family: Georgia, "Times New Roman", serif; font-weight: 400; }
	.hero-lede { max-width: 675px; margin: 36px 0 0; color: #46534b; font-size: clamp(1.06rem, 1.5vw, 1.28rem); }
	.hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 38px; }
	.button { min-height: 50px; display: inline-flex; align-items: center; justify-content: center; gap: 24px; padding: 12px 18px; border: 1px solid var(--forest); border-radius: 10px; font-size: .78rem; font-weight: 800; text-decoration: none; transition: transform .2s ease, box-shadow .2s ease; }
	.button:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(13,23,20,.1); }
	.button-primary { color: white; background: var(--forest); }
	.button-secondary { background: transparent; }

	.profile-panel { padding: 24px; border: 1px solid var(--line); border-radius: 22px; background: var(--white); box-shadow: 0 28px 65px rgba(29,44,36,.09); transform: rotate(1.2deg); }
	.profile-top { display: flex; align-items: center; gap: 15px; padding-bottom: 22px; border-bottom: 1px solid var(--line); }
	.profile-top img { width: 88px; height: 88px; border-radius: 18px; object-fit: cover; filter: saturate(.85) contrast(1.03); }
	.profile-top p { margin: 0; font-weight: 780; }
	.profile-top span { color: var(--muted); font-size: .75rem; }
	.profile-note { margin: 22px 0; color: #435048; font-family: Georgia, "Times New Roman", serif; font-size: 1.2rem; line-height: 1.35; }
	.profile-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
	.profile-stats div { min-height: 126px; display: flex; flex-direction: column; justify-content: space-between; padding: 15px; border-radius: 14px; background: #eef1eb; }
	.profile-stats strong { font-size: 1.8rem; line-height: 1; letter-spacing: -.05em; }
	.profile-stats span { color: var(--muted); font-size: .68rem; line-height: 1.35; }
	.profile-links { margin-top: 16px; border-top: 1px solid var(--line); }
	.profile-links a { display: flex; justify-content: space-between; padding: 13px 2px; border-bottom: 1px solid var(--line); font-size: .72rem; font-weight: 750; text-decoration: none; }
	.profile-links a span { color: var(--muted); font-weight: 600; }

	.signal-strip { border-block: 1px solid var(--line); background: var(--white); }
	.signal-inner { min-height: 88px; display: grid; grid-template-columns: 150px 1fr; align-items: center; }
	.signal-inner > p { margin: 0; color: var(--muted); font-size: .67rem; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; }
	.signal-inner ul { margin: 0; padding: 0; display: flex; justify-content: space-between; gap: 20px; list-style: none; }
	.signal-inner li { font-size: .8rem; font-weight: 720; }
	.signal-inner li::before { content: '•'; margin-right: 18px; color: var(--mint); }

	.work-section { padding-block: 125px 145px; }
	.section-heading { margin-bottom: 72px; display: grid; grid-template-columns: 1fr 360px; gap: 60px; align-items: end; }
	.section-heading h2, .experience-heading h2 { margin-top: 17px; font-size: clamp(2.6rem, 5vw, 5rem); line-height: .98; letter-spacing: -.055em; }
	.section-heading > p { margin: 0 0 7px; color: var(--muted); font-size: .94rem; }
	.project-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
	.project-card { overflow: hidden; border: 1px solid var(--line); border-radius: 22px; background: var(--white); }
	.project-card.featured { grid-column: 1 / -1; display: grid; grid-template-columns: 1.12fr .88fr; }
	.project-visual { min-height: 360px; padding: clamp(24px, 4vw, 48px); display: grid; place-items: center; background: #e6eee9; }
	.featured .project-visual { min-height: 520px; }
	.project-copy { padding: 34px; }
	.featured .project-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(40px, 5vw, 72px); }
	.project-meta { display: flex; align-items: center; gap: 12px; }
	.project-meta span { color: var(--green); font: 700 .78rem/1 ui-monospace, SFMono-Regular, Consolas, monospace; }
	.project-meta p { margin: 0; color: var(--muted); font-size: .67rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
	.project-copy h3 { margin-top: 24px; font-size: clamp(1.75rem, 2.6vw, 2.85rem); line-height: 1.02; letter-spacing: -.045em; }
	.project-description { margin: 25px 0; color: #536058; font-size: .9rem; }
	.outcome-list { margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 7px; list-style: none; }
	.outcome-list li { padding: 7px 10px; border: 1px solid var(--line); border-radius: 999px; font-size: .66rem; font-weight: 750; }
	.tool-line { margin: 30px 0 0; padding-top: 20px; border-top: 1px solid var(--line); color: var(--muted); font-size: .69rem; }

	.carbon-ui { width: min(100%, 560px); padding: 18px; border: 1px solid rgba(15,30,25,.15); border-radius: 16px; background: rgba(255,255,255,.82); box-shadow: 0 25px 50px rgba(20,50,37,.12); transform: rotate(-1.5deg); }
	.ui-bar { display: flex; align-items: center; gap: 6px; padding-bottom: 13px; border-bottom: 1px solid var(--line); }
	.ui-bar i { width: 7px; height: 7px; border-radius: 50%; background: #b9c1bb; }
	.ui-bar span { margin-left: auto; color: var(--muted); font-size: .58rem; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; }
	.carbon-main { display: grid; grid-template-columns: .75fr 1.25fr; gap: 24px; padding: 25px 0; }
	.score { display: flex; flex-direction: column; justify-content: center; align-items: center; aspect-ratio: 1; border: 12px solid #c9f1df; border-top-color: var(--green); border-radius: 50%; }
	.score strong { font-size: clamp(1.7rem, 4vw, 3.2rem); line-height: 1; letter-spacing: -.06em; }
	.score span { margin-top: 5px; color: var(--muted); font-size: .58rem; }
	.zone-list { display: grid; align-content: center; }
	.zone-list span { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 8px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: .65rem; }
	.zone-list i { width: 7px; height: 7px; border-radius: 50%; background: var(--mint); }
	.zone-list b { color: var(--muted); font-size: .55rem; text-transform: uppercase; }
	.carbon-bars { height: 62px; display: flex; align-items: end; gap: 7px; }
	.carbon-bars i { flex: 1; border-radius: 3px 3px 0 0; background: var(--green); }
	.carbon-bars i:nth-child(1) { height: 32%; }.carbon-bars i:nth-child(2) { height: 48%; }.carbon-bars i:nth-child(3) { height: 44%; }.carbon-bars i:nth-child(4) { height: 68%; }.carbon-bars i:nth-child(5) { height: 61%; }.carbon-bars i:nth-child(6) { height: 83%; }.carbon-bars i:nth-child(7) { height: 77%; }.carbon-bars i:nth-child(8) { height: 96%; background: var(--mint); }

	.project-framework .project-visual { background: var(--blue); }
	.framework-ui { width: min(100%, 460px); padding: 16px; border-radius: 18px; color: #eef6ff; background: #172c49; box-shadow: 0 25px 50px rgba(23,44,73,.18); }
	.framework-ui > p { margin: 3px 4px 15px; color: #aebed4; font-size: .61rem; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; }
	.system-row { display: grid; grid-template-columns: 34px 70px 1fr; align-items: center; padding: 15px 13px; border-top: 1px solid rgba(255,255,255,.12); font-size: .65rem; }
	.system-row span { color: #8296b1; font-family: ui-monospace, monospace; }.system-row strong { font-size: .72rem; }.system-row i { color: #9eb0c6; font-style: normal; text-align: right; }
